# HOD Platform — copie para .env e preencha. Nunca commite o .env real.
PORT=8877
APP_ORIGIN=http://localhost:8877
# Origens liberadas no CORS (Web V1, Vite dos 3 apps, Electron file:// via token)
CORS_ORIGINS=http://localhost:8787,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177

# Google OAuth (mesmos valores da V1 — reutilize o .env da V1 na migração)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8877/api/v1/auth/google/callback
APP_ENCRYPTION_KEY=
INITIAL_ADMIN_EMAIL=

# Banco central da Platform (NÃO aponte para o banco da V1)
DATABASE_PATH=./data/hod-platform.sqlite
# Caminho somente-leitura do banco da V1, usado apenas pelo script de migração
V1_DATABASE_PATH=/Users/leandro/Documents/HOD Workspace/apps/hod-hub/data/hod-hub.sqlite
V1_ENV_PATH=/Users/leandro/Documents/HOD Workspace/apps/hod-hub/.env
ARCHIVE_DIR=
COOKIE_SECURE=0
