{
  "name": "hod-hub",
  "version": "4.2.0",
  "type": "module",
  "description": "Aplicativo local para gestão operacional das consultorias HOD.",
  "scripts": {
    "dev": "vite --clearScreen false",
    "build": "NODE_ENV=production vite build",
    "build:dev": "NODE_ENV=development vite build",
    "preview": "vite preview",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "smoke": "node scripts/smoke.mjs",
    "test": "node --test",
    "app": "node server/server.js",
    "app:dev": "node --watch server/server.js"
  },
  "keywords": [
    "hod-hub",
    "google-calendar",
    "consultorias",
    "crm",
    "vite",
    "vanilla-js",
    "pwa"
  ],
  "author": "Leandro Batista",
  "license": "MIT",
  "main": "src/main.js",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "sass": "^1.101.3",
    "terser": "^5.49.0",
    "vite": "^8.1.5"
  },
  "dependencies": {
    "express": "^5.1.0",
    "helmet": "^8.1.0"
  }
}
